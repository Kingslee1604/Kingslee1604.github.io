---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { newTab } from '../../data/profile';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => p.data.caseStudy);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, tags, repo, release, cover, coverAlt, demo } = project.data;
const { Content } = await render(project);
---

<Base
  title={`${title} case study`}
  description={summary}
  type="article"
  ogImage={`/og/${project.id}.png`}
  ogImageAlt={`${title} case study: ${summary}`}
>
  <article class="container case">
    <p class="back"><a href="/#projects">← All projects</a></p>
    <header class="case-head">
      <p class="eyebrow">Case study</p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <ul class="tags" aria-label="Technologies">
        {tags.map((t) => <li>{t}</li>)}
      </ul>
      <div class="actions">
        <a class="btn btn-primary" href={repo} {...newTab}>
          View the code<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
        {
          release && (
            <a class="btn" href={release.url} {...newTab}>
              Release {release.label}
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          )
        }
      </div>
    </header>

    {
      /* A small still image loads first (fast to show); the animated demo loads only when the
         visitor presses Play, and can be stopped, so nothing moves without their choice. */
      cover && (
        <figure class="demo">
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            widths={[480, 820, 1104]}
            sizes="(min-width: 1184px) 1104px, 100vw"
            loading="eager"
            fetchpriority="high"
            data-demo-still
          />
          {demo && <img data-demo-gif data-src={demo.src} width={demo.width} height={demo.height} alt={demo.alt} hidden />}
          {
            demo && (
              <div class="demo-controls">
                <button type="button" class="btn btn-primary" data-demo-toggle hidden>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M7 4.5v15l13-7.5z" />
                  </svg>
                  <span data-demo-label>Play the demo</span>
                </button>
                <noscript>
                  <a href={demo.src}>Watch the demo (animated GIF)</a>
                </noscript>
              </div>
            )
          }
          <figcaption>
            {
              demo
                ? 'A time-lapse recorded on the CPU-only laptop with the real model and fictional demo documents: about 15 minutes in 8 seconds.'
                : coverAlt
            }
          </figcaption>
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>('.demo')) {
    const still = figure.querySelector<HTMLImageElement>('[data-demo-still]');
    const gif = figure.querySelector<HTMLImageElement>('[data-demo-gif]');
    const button = figure.querySelector<HTMLButtonElement>('[data-demo-toggle]');
    const label = figure.querySelector('[data-demo-label]');
    if (!still || !gif || !button || !label) continue;
    button.hidden = false;
    button.addEventListener('click', () => {
      const play = gif.hidden;
      if (play && !gif.getAttribute('src')) gif.src = gif.dataset.src ?? '';
      gif.hidden = !play;
      still.hidden = play;
      label.textContent = play ? 'Stop the demo' : 'Play the demo';
    });
  }
</script>

<style>
  .case {
    padding-block: 32px 24px;
  }
  .back {
    margin-bottom: 24px;
  }
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .case-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 820px;
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  h1 {
    font-size: clamp(34px, 6vw, 52px);
  }
  .lede {
    font-size: 19px;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 4px;
  }
  .demo {
    margin: 40px 0;
  }
  .demo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .demo-controls {
    margin-top: 14px;
  }
  .demo figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 15px;
  }

  /* Styles for the Markdown body. */
  .prose {
    max-width: 820px;
  }
  .prose :global(h2) {
    font-size: 28px;
    margin: 48px 0 16px;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 16px;
  }
  .prose :global(li + li) {
    margin-top: 8px;
  }
  .prose :global(code) {
    font-size: 0.9em;
    background: var(--surface-2);
    border-radius: 4px;
    padding: 1px 5px;
  }
  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin-block: 8px;
  }
  .prose :global(table) {
    /* Contains the links' hidden "(opens in a new tab)" text, so it can't widen the page. */
    position: relative;
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 15px;
    margin-bottom: 16px;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
  }
  .prose :global(th) {
    font-weight: 600;
  }

  /* The architecture diagram scrolls inside its own box on narrow screens. */
  .prose :global(.diagram) {
    margin: 8px 0 24px;
  }
  .prose :global(.diagram-scroll) {
    position: relative;
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
  }
  .prose :global(.diagram svg) {
    display: block;
    min-width: 620px;
    width: 100%;
  }
  .prose :global(.diagram figcaption) {
    margin-top: 10px;
    color: var(--muted);
    font-size: 15px;
  }
  .prose :global(.d-lines line) {
    stroke: var(--muted);
    stroke-width: 1.5;
  }
  .prose :global(.d-arrowhead) {
    fill: var(--muted);
  }
  .prose :global(.d-box rect) {
    fill: var(--surface-2);
    stroke: var(--border-strong);
  }
  .prose :global(.d-key rect) {
    stroke: var(--accent-text);
    stroke-width: 2;
  }
  .prose :global(.d-box text) {
    fill: var(--text);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    text-anchor: middle;
  }
  .prose :global(.d-box .d-sub) {
    fill: var(--muted);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
  }
</style>
