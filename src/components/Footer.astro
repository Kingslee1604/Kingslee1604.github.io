---
import { profile, newTab } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container row">
    <p>© {year} {profile.fullName}</p>
    <p>
      <a href={profile.links.linkedin} {...newTab}>LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a> ·
      <a href={profile.links.github} {...newTab}>GitHub<span class="visually-hidden"> (opens in a new tab)</span></a> ·
      <a href={profile.links.siteRepo} {...newTab}>
        Source for this site<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 72px;
    color: var(--muted);
    font-size: 15px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 28px;
  }
</style>
